{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/politica-de-privacidade",
      "destination": "/Docs/privacy-policy.html",
      "permanent": true
    },
    {
      "source": "/termos-de-uso",
      "destination": "/Docs/terms-of-use.html",
      "permanent": true
    },
    {
      "source": "/privacidade-e-seguranca",
      "destination": "/Docs/index.html",
      "permanent": true
    },
    {
      "source": "/privacy-policy.md",
      "destination": "/Docs/privacy-policy.html",
      "permanent": true
    },
    {
      "source": "/terms-of-use.md",
      "destination": "/Docs/terms-of-use.html",
      "permanent": true
    },
    {
      "source": "/Forms/:path*",
      "destination": "/Docs/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ]
}
